<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VizoLife AI</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 15px;
            color: #fff;
        }
        .container { max-width: 500px; margin: 0 auto; padding-bottom: 90px; }
        .header { text-align: center; margin-bottom: 15px; }
        .logo { font-size: 2.2em; font-weight: bold; }
        .tagline { font-size: 0.95em; opacity: 0.9; margin-top: 3px; }
        
        .tabs {
            display: flex;
            overflow-x: auto;
            gap: 8px;
            padding: 5px 0 15px;
            margin-bottom: 5px;
            -webkit-overflow-scrolling: touch;
        }
        .tabs::-webkit-scrollbar { display: none; }
        .tab {
            flex-shrink: 0;
            background: rgba(255,255,255,0.15);
            border-radius: 25px;
            padding: 8px 16px;
            font-size: 0.85em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
            text-align: center;
        }
        .tab:hover { background: rgba(255,255,255,0.25); }
        .tab.active { background: #fff; color: #667eea; border-color: #fff; }
        .tab-icon { font-size: 1.2em; display: block; margin-bottom: 2px; }
        
        .panel { display: none; }
        .panel.active { display: block; }
        
        .section {
            background: rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 18px;
            margin-bottom: 15px;
            backdrop-filter: blur(10px);
        }
        .section-title { font-size: 1.1em; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        
        .upload-area {
            border: 2px dashed rgba(255,255,255,0.5);
            border-radius: 15px;
            padding: 30px 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }
        .upload-area:hover { background: rgba(255,255,255,0.1); }
        .upload-area.has-image { padding: 10px; }
        .upload-area img { max-width: 100%; max-height: 280px; border-radius: 10px; }
        .upload-icon { font-size: 2.5em; margin-bottom: 8px; }
        .upload-label { font-size: 0.9em; }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 10px;
        }
        .gallery-item {
            background: rgba(255,255,255,0.15);
            border-radius: 10px;
            padding: 10px 6px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
            font-size: 0.8em;
        }
        .gallery-item:hover { background: rgba(255,255,255,0.25); }
        .gallery-item.selected { border-color: #fff; background: rgba(255,255,255,0.3); }
        .gallery-item .item-icon { font-size: 1.8em; display: block; margin-bottom: 3px; }
        
        .try-btn {
            position: fixed;
            bottom: 0; left: 0; right: 0;
            background: #fff;
            color: #667eea;
            border: none;
            padding: 18px;
            font-size: 1.15em;
            font-weight: bold;
            cursor: pointer;
            max-width: 500px;
            margin: 0 auto;
            display: block;
            transition: all 0.3s;
            z-index: 100;
        }
        .try-btn:hover { box-shadow: 0 -5px 20px rgba(0,0,0,0.3); }
        .try-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .loading { display: none; text-align: center; padding: 20px; }
        .loading.show { display: block; }
        .spinner {
            border: 4px solid rgba(255,255,255,0.3);
            border-top: 4px solid #fff;
            border-radius: 50%;
            width: 45px; height: 45px;
            animation: spin 1s linear infinite;
            margin: 15px auto;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .result { display: none; text-align: center; }
        .result.show { display: block; }
        .result img { max-width: 100%; border-radius: 15px; margin-top: 10px; }
        .result-actions { display: flex; gap: 10px; margin-top: 15px; }
        .result-actions button {
            flex: 1;
            background: rgba(255,255,255,0.2);
            color: #fff;
            border: 2px solid #fff;
            padding: 12px;
            border-radius: 15px;
            font-size: 0.9em;
            cursor: pointer;
        }
        .error { color: #ff6b6b; text-align: center; margin-top: 10px; display: none; }
        .error.show { display: block; }
        
        .looks-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 10px; }
        .look-card { background: rgba(255,255,255,0.1); border-radius: 12px; overflow: hidden; }
        .look-card img { width: 100%; height: 130px; object-fit: cover; }
        .look-card .look-date { padding: 6px; font-size: 0.75em; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">👗 VizoLife AI</div>
            <div class="tagline">Карманная AI-примерочная</div>
        </div>

        <div class="tabs">
            <div class="tab active" data-panel="tryon"><span class="tab-icon">👗</span>Одежда</div>
            <div class="tab" data-panel="makeup"><span class="tab-icon">💄</span>Макияж</div>
            <div class="tab" data-panel="hair"><span class="tab-icon"></span>Причёска</div>
            <div class="tab" data-panel="shoes"><span class="tab-icon">👟</span>Обувь</div>
            <div class="tab" data-panel="looks"><span class="tab-icon">🖼</span>Мои образы</div>
        </div>

        <!-- ПРИМЕРКА ОДЕЖДЫ -->
        <div class="panel active" id="panel-tryon">
            <div class="section">
                <div class="section-title"><span></span> Твоё фото</div>
                <div class="upload-area" id="photoUpload">
                    <div class="upload-icon"></div>
                    <div class="upload-label">Нажми чтобы загрузить фото</div>
                </div>
                <input type="file" id="photoInput" accept="image/*" style="display:none">
            </div>
            <div class="section">
                <div class="section-title"><span>👕</span> Категория</div>
                <div class="gallery-grid">
                    <div class="gallery-item selected" data-cat="women"><span class="item-icon">👗</span>Женское</div>
                    <div class="gallery-item" data-cat="men"><span class="item-icon"></span>Мужское</div>
                    <div class="gallery-item" data-cat="kids"><span class="item-icon">👶</span>Детское</div>
                </div>
            </div>
            <div class="section">
                <div class="section-title"><span>👕</span> Фото одежды</div>
                <div class="upload-area" id="clothesUpload">
                    <div class="upload-icon">👕</div>
                    <div class="upload-label">Загрузи фото одежды</div>
                </div>
                <input type="file" id="clothesInput" accept="image/*" style="display:none">
            </div>
        </div>

        <!-- МАКИЯЖ -->
        <div class="panel" id="panel-makeup">
            <div class="section">
                <div class="section-title"><span></span> Твоё фото (лицо)</div>
                <div class="upload-area" id="makeupPhotoUpload">
                    <div class="upload-icon">📷</div>
                    <div class="upload-label">Загрузи фото лица крупным планом</div>
                </div>
                <input type="file" id="makeupPhotoInput" accept="image/*" style="display:none">
            </div>
            <div class="section">
                <div class="section-title"><span>💄</span> Стиль макияжа</div>
                <div class="gallery-grid">
                    <div class="gallery-item selected" data-makeup="natural"><span class="item-icon">🌸</span>Натуральный</div>
                    <div class="gallery-item" data-makeup="evening"><span class="item-icon">✨</span>Вечерний</div>
                    <div class="gallery-item" data-makeup="bold"><span class="item-icon"></span>Яркий</div>
                    <div class="gallery-item" data-makeup="bridal"><span class="item-icon">👰</span>Свадебный</div>
                    <div class="gallery-item" data-makeup="korean"><span class="item-icon">🇰🇷</span>Корейский</div>
                    <div class="gallery-item" data-makeup="vintage"><span class="item-icon">💃</span>Винтажный</div>
                </div>
            </div>
        </div>

        <!-- ПРИЧЁСКА -->
        <div class="panel" id="panel-hair">
            <div class="section">
                <div class="section-title"><span></span> Твоё фото</div>
                <div class="upload-area" id="hairPhotoUpload">
                    <div class="upload-icon"></div>
                    <div class="upload-label">Загрузи фото</div>
                </div>
                <input type="file" id="hairPhotoInput" accept="image/*" style="display:none">
            </div>
            <div class="section">
                <div class="section-title"><span></span> Стиль причёски</div>
                <div class="gallery-grid">
                    <div class="gallery-item selected" data-hair="short"><span class="item-icon">✂️</span>Короткая</div>
                    <div class="gallery-item" data-hair="long"><span class="item-icon">💇</span>Длинная</div>
                    <div class="gallery-item" data-hair="curly"><span class="item-icon">🌀</span>Кудри</div>
                    <div class="gallery-item" data-hair="blonde"><span class="item-icon">👱</span>Блонд</div>
                    <div class="gallery-item" data-hair="brunette"><span class="item-icon"></span>Брюнет</div>
                    <div class="gallery-item" data-hair="red"><span class="item-icon">🦰</span>Рыжая</div>
                </div>
            </div>
        </div>

        <!-- ОБУВЬ -->
        <div class="panel" id="panel-shoes">
            <div class="section">
                <div class="section-title"><span>📸</span> Твоё фото (в полный рост)</div>
                <div class="upload-area" id="shoesPhotoUpload">
                    <div class="upload-icon"></div>
                    <div class="upload-label">Фото в полный рост</div>
                </div>
                <input type="file" id="shoesPhotoInput" accept="image/*" style="display:none">
            </div>
            <div class="section">
                <div class="section-title"><span></span> Фото обуви</div>
                <div class="upload-area" id="shoesUpload">
                    <div class="upload-icon"></div>
                    <div class="upload-label">Загрузи фото обуви</div>
                </div>
                <input type="file" id="shoesInput" accept="image/*" style="display:none">
            </div>
        </div>

        <!-- МОИ ОБРАЗЫ -->
        <div class="panel" id="panel-looks">
            <div class="section">
                <div class="section-title"><span>🖼</span> Сохранённые образы</div>
                <div class="looks-grid" id="looksGrid">
                    <div style="grid-column:span 2;text-align:center;padding:30px;opacity:0.6">Пока пусто</div>
                </div>
            </div>
        </div>

        <div class="result" id="result">
            <div class="section-title"><span>🎉</span> Готово!</div>
            <div id="resultImage"></div>
            <div class="result-actions">
                <button id="saveLook">💾 Сохранить</button>
                <button id="shareLook">📤 Поделиться</button>
            </div>
        </div>
        <div class="error" id="error"></div>
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <div>AI создаёт твой образ... (30-60 сек)</div>
        </div>
    </div>

    <button class="try-btn" id="tryBtn">✨ Примерить</button>

    <script>
        if (window.Telegram && window.Telegram.WebApp) {
            window.Telegram.WebApp.ready();
            window.Telegram.WebApp.expand();
        }

        const API_URL = "http://5.181.253.139:8001";
        let currentTab = 'tryon';
        let selectedMakeup = 'natural';
        let selectedHair = 'short';
        let myLooks = JSON.parse(localStorage.getItem('vizolife_looks') || '[]');
        let lastResult = null;

        document.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                currentTab = tab.dataset.panel;
                document.getElementById('panel-' + currentTab).classList.add('active');
                document.getElementById('result').classList.remove('show');
                document.getElementById('error').classList.remove('show');
                if (currentTab === 'looks') renderLooks();
            });
        });

        function setupUpload(uploadId, inputId) {
            const upload = document.getElementById(uploadId);
            const input = document.getElementById(inputId);
            upload.addEventListener('click', () => input.click());
            input.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        upload.innerHTML = '<img src="' + ev.target.result + '">';
                        upload.classList.add('has-image');
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
        setupUpload('photoUpload', 'photoInput');
        setupUpload('clothesUpload', 'clothesInput');
        setupUpload('makeupPhotoUpload', 'makeupPhotoInput');
        setupUpload('hairPhotoUpload', 'hairPhotoInput');
        setupUpload('shoesPhotoUpload', 'shoesPhotoInput');
        setupUpload('shoesUpload', 'shoesInput');

        document.querySelectorAll('.gallery-item').forEach(item => {
            item.addEventListener('click', () => {
                const parent = item.parentElement;
                parent.querySelectorAll('.gallery-item').forEach(i => i.classList.remove('selected'));
                item.classList.add('selected');
                if (item.dataset.makeup) selectedMakeup = item.dataset.makeup;
                if (item.dataset.hair) selectedHair = item.dataset.hair;
            });
        });

        document.getElementById('tryBtn').addEventListener('click', async () => {
            const loading = document.getElementById('loading');
            const result = document.getElementById('result');
            const error = document.getElementById('error');
            const btn = document.getElementById('tryBtn');

            if (currentTab === 'tryon') {
                const pu = document.getElementById('photoUpload');
                const cu = document.getElementById('clothesUpload');
                if (!pu.classList.contains('has-image') || !cu.classList.contains('has-image')) {
                    alert('Загрузи фото себя и одежду!');
                    return;
                }
                loading.classList.add('show');
                result.classList.remove('show');
                error.classList.remove('show');
                btn.disabled = true;

                const formData = new FormData();
                formData.append('person_image', document.getElementById('photoInput').files[0]);
                formData.append('garment_image', document.getElementById('clothesInput').files[0]);

                try {
                    const response = await fetch(API_URL + '/try-on', { method: 'POST', body: formData });
                    const data = await response.json();
                    if (data.success) {
                        loading.classList.remove('show');
                        result.classList.add('show');
                        lastResult = data.result;
                        document.getElementById('resultImage').innerHTML = '<img src="' + data.result + '">';
                    } else { throw new Error(data.detail || 'Ошибка'); }
                } catch (err) {
                    loading.classList.remove('show');
                    error.textContent = 'Ошибка: ' + err.message;
                    error.classList.add('show');
                } finally { btn.disabled = false; }
            } else if (currentTab === 'makeup') {
                alert(' Макияж: будет готов на 2 этапе!');
            } else if (currentTab === 'hair') {
                alert('💇 Причёска: будет готова на 2 этапе!');
            } else if (currentTab === 'shoes') {
                alert('👟 Обувь: будет готова на 2 этапе!');
            }
        });

        document.getElementById('saveLook').addEventListener('click', () => {
            if (lastResult) {
                myLooks.push({ url: lastResult, date: new Date().toLocaleDateString('ru') });
                localStorage.setItem('vizolife_looks', JSON.stringify(myLooks));
                alert('💾 Образ сохранён!');
            }
        });

        document.getElementById('shareLook').addEventListener('click', () => {
            if (lastResult) {
                if (navigator.share) {
                    navigator.share({ title: 'Мой образ от VizoLife AI', url: lastResult });
                } else {
                    navigator.clipboard.writeText(lastResult);
                    alert(' Ссылка скопирована!');
                }
            }
        });

        function renderLooks() {
            const grid = document.getElementById('looksGrid');
            if (myLooks.length === 0) {
                grid.innerHTML = '<div style="grid-column:span 2;text-align:center;padding:30px;opacity:0.6">Пока пусто</div>';
                return;
            }
            grid.innerHTML = myLooks.map(look =>
                '<div class="look-card"><img src="' + look.url + '"><div class="look-date">' + look.date + '</div></div>'
            ).join('');
        }
    </script>
</body>
</html>
